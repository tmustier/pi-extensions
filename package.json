      "./extending-pi/skill-creator/SKILL.md",
      "./pi-ralph-wiggum/SKILL.md"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
